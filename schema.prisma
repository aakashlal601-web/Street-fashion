generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id            String      @id @default(cuid())
  name          String
  category      String
  price         Float
  discountPrice Float?
  sizes         String[]
  colors        String[]
  stock         Int         @default(0)
  description   String
  imageUrl      String
  imagePublicId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]

  @@index([category])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String
  phone        String
  address      String
  total        Float
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  size      String
  color     String
  price     Float
  qty       Int
}

model StoreSettings {
  id                Int    @id @default(1)
  storeName         String @default("STREET FASHION")
  tagline           String @default("GEARED FOR THE STREET")
  email             String @default("hello@streetfashion.com")
  phone             String @default("")
  currency          String @default("$")
  shippingFee       Float  @default(6)
  lowStockThreshold Int    @default(5)
}
